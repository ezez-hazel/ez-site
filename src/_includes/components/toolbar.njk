<header>
  <nav aria-label="主导航">
    <a class="toolbar-logo" href="/" aria-label="返回首页">
      <img
        src="/icons/icon@128.png"
        srcset="/icons/icon@64.png 64w, /icons/icon@128.png 128w, /icons/icon@256.png 256w, /icons/icon@512.png 512w, /icons/icon@1024.PNG 1024w"
        sizes="(max-width: 768px) 3rem, 4.5rem"
        alt="一几一几"
      >
    </a>
    <div class="toolbar-menu">
      <button class="toolbar-toggle" type="button" aria-expanded="false" aria-controls="toolbar-links">菜单</button>
      <div class="toolbar-links" id="toolbar-links">
        {% for toolbar in collections.toolbar | sortByDataField('order') %}
          <a href="{{ toolbar.url }}">{{ toolbar.data.title }}</a>
        {% endfor %}
        <details class="tool-menu">
          <summary>实用工具</summary>
          <ul>
            {% for tool in collections.tools %}
              <li><a href="{{ tool.url }}">{{ tool.data.title }}</a></li>
            {% endfor %}
          </ul>
        </details>
        <details class="tool-menu">
          <summary>外部链接</summary>
          <ul>
            {% for external_link in collections.external_links %}
              <li><a href="{{ external_link.data.link }}" target="_blank">{{ external_link.data.name }}</a></li>
            {% endfor %}
          </ul>
        </details>
      </div>
    </div>
  </nav>
</header>